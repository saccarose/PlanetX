; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="Planet X"
run/main_scene="res://scenes/intro.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://icon-new.png"

[autoload]

PlayerInventory="*res://code_resources/PlayerInventory.gd"
JsonData="*res://code_resources/JsonData.gd"

[debug]

settings/fps/force_fps=60
shapes/collision/shape_color=Color( 1, 1, 1, 0.419608 )
shapes/collision/contact_color=Color( 0.141176, 0.027451, 0.0117647, 0.8 )
shapes/navigation/geometry_color=Color( 0.0627451, 0.0588235, 0.345098, 0.4 )
shapes/navigation/disabled_geometry_color=Color( 0.235294, 0.0352941, 0.415686, 0.4 )

[display]

window/size/width=1280
window/size/height=640
window/size/resizable=false
window/energy_saving/keep_screen_on=false
mouse_cursor/custom_image="res://purple_cursor.png"

[gui]

common/drop_mouse_on_gui_input_disabled=true

